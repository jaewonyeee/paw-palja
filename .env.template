# === LLM Provider (택 1: "google" 또는 "azure") ===
LLM_PROVIDER=google

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Azure OpenAI (전환 시 LLM_PROVIDER=azure로 변경)
AOAI_API_KEY=your_azure_openai_key_here
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002
AOAI_API_VERSION=2024-06-01

# === External Tools ===
TAVILY_API_KEY=your_tavily_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
APIFY_API_KEY=your_apify_api_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# === Security ===
ADMIN_PASSWORD=change_this_admin_password
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === Database ===
CHROMA_PATH=./data/chroma
