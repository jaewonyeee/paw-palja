# === LLM Provider (택 1: "google" 또는 "azure") ===
LLM_PROVIDER=google

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_NAME=gemini-1.5-flash
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# Azure OpenAI (전환 시 LLM_PROVIDER=azure로 변경)
AOAI_API_KEY=your_azure_openai_key_here
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_DEPLOYMENT_NAME=gpt-4o
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002
AOAI_API_VERSION=2024-06-01

# === External Tools ===
TAVILY_API_KEY=your_tavily_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
APIFY_API_KEY=your_apify_api_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# === Security ===
ADMIN_PASSWORD=change_this_admin_password
# For local dev: http://localhost:3000,http://localhost:8000
# For production: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT_SECRET: MUST be a strong, random, unique string (64+ characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: Using weak secrets (e.g. "secret", "password", "jwt-secret") will
# be rejected at startup and replaced with an ephemeral key that won't
# survive restarts. ALL user sessions will be invalidated on each restart.
JWT_SECRET=GENERATE_A_STRONG_SECRET_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_EXPIRE_MINUTES=5
JWT_REFRESH_EXPIRE_DAYS=7

# === Database ===
# Local dev: comment out to use SQLite (sqlite+aiosqlite:///./data/pawpalja.db)
# Local Docker: set in docker-compose.prod.yml environment
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pawpalja
CHROMA_PATH=./data/chroma

# === Docker Production (used by docker-compose.prod.yml) ===
DB_PASSWORD=change_this_db_password
REDIS_URL=redis://localhost:6379/0
# Note: DATABASE_URL and REDIS_URL are overridden in docker-compose.prod.yml
# to use Docker service names (db, redis).

# === Web Push Notifications (VAPID) ===
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=mailto:admin@pawpalja.com

# === Task Queue (ARQ) ===
# Set to true to enable async diary generation via background workers.
# When false (default), diary generation blocks the HTTP request.
USE_TASK_QUEUE=false
ARQ_MAX_JOBS=3
ARQ_JOB_TIMEOUT=120

# === Cloud Deployment (used by docker-compose.cloud.yml) ===
# DigitalOcean Managed PostgreSQL (requires sslmode=require):
#   postgresql+asyncpg://user:password@db-host:25060/pawpalja?sslmode=require
CLOUD_DATABASE_URL=postgresql+asyncpg://user:password@managed-db-host:25060/pawpalja?sslmode=require
# DigitalOcean Managed Redis (uses rediss:// for TLS):
CLOUD_REDIS_URL=rediss://default:password@managed-redis-host:25061/0
# CDN base URL for static assets (leave empty to serve from nginx)
CDN_BASE_URL=
# SSL domain for Let's Encrypt certificate
SSL_DOMAIN=pawpalja.example.com
SSL_EMAIL=admin@pawpalja.com

# === EC2 Deployment ===
# Frontend URL (Cloudflare Pages) — needed for CORS
# ALLOWED_ORIGINS=https://pawpalja.com,https://www.pawpalja.com
# API domain (for Nginx SSL)
# API_DOMAIN=api.pawpalja.com

# === CI/CD (GitHub Actions Secrets — NOT in .env file) ===
# EC2_HOST=your-ec2-public-ip
# EC2_USER=ubuntu
# EC2_SSH_KEY=(private key content)

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
