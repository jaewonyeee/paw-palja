# === LLM Provider (택 1: "google" 또는 "azure") ===
LLM_PROVIDER=google

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Azure OpenAI (전환 시 LLM_PROVIDER=azure로 변경)
AOAI_API_KEY=your_azure_openai_key_here
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_DEPLOYMENT_NAME=gpt-4o
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002
AOAI_API_VERSION=2024-06-01

# === External Tools ===
TAVILY_API_KEY=your_tavily_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
APIFY_API_KEY=your_apify_api_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# === Security ===
ADMIN_PASSWORD=change_this_admin_password
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT_SECRET: MUST be a strong, random, unique string (64+ characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: Using weak secrets (e.g. "secret", "password", "jwt-secret") will
# be rejected at startup and replaced with an ephemeral key that won't
# survive restarts. ALL user sessions will be invalidated on each restart.
JWT_SECRET=GENERATE_A_STRONG_SECRET_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_EXPIRE_MINUTES=5
JWT_REFRESH_EXPIRE_DAYS=7

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pawpalja
CHROMA_PATH=./data/chroma

# === Docker Production (used by docker-compose.prod.yml) ===
DB_PASSWORD=change_this_db_password
REDIS_URL=redis://redis:6379/0
# Note: DATABASE_URL is overridden in docker-compose.prod.yml environment
# to use the Docker service name: postgresql+asyncpg://pawpalja:${DB_PASSWORD}@db:5432/pawpalja

# === Web Push Notifications (VAPID) ===
# Generate keys with: python -c "from pywebpush import webpush; from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('Private:', v.private_pem()); print('Public:', v.public_key)"
# Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=mailto:admin@pawpalja.com

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
