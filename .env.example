# ============================================
# Paw-Palja 환경변수 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ============================================

# === LLM Provider 선택 ===
# "google" (Google Gemini) 또는 "azure" (Azure OpenAI) 중 택 1
LLM_PROVIDER=google

# === Google Gemini (LLM_PROVIDER=google일 때) ===
# Google AI Studio에서 발급: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_NAME=gemini-1.5-flash
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# === Azure OpenAI (LLM_PROVIDER=azure일 때) ===
# Azure Portal에서 발급
AOAI_API_KEY=your_azure_openai_key_here
AOAI_ENDPOINT=https://your-resource.openai.azure.com/
AOAI_DEPLOYMENT_NAME=gpt-4o
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002
AOAI_API_VERSION=2024-06-01

# === 외부 도구 API 키 (선택사항) ===
# 미설정 시 해당 기능 없이 동작합니다
TAVILY_API_KEY=your_tavily_api_key_here          # 트렌드 검색 (Oracle Agent)
OPENWEATHER_API_KEY=your_openweather_api_key_here # 날씨 정보 (Oracle Agent)
APIFY_API_KEY=your_apify_api_key_here            # SNS 데이터 수집
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here  # 동물병원 검색

# === 보안 ===
ADMIN_PASSWORD=change_this_admin_password
# CORS 허용 도메인 (콤마로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT 비밀키: 64자 이상의 랜덤 문자열 필요
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 미설정 시 임시 키가 자동 생성됩니다 (재시작마다 세션 초기화)
JWT_SECRET=GENERATE_A_STRONG_SECRET_WITH_python_-c_"import secrets; print(secrets.token_urlsafe(64))"
JWT_ACCESS_EXPIRE_MINUTES=5
JWT_REFRESH_EXPIRE_DAYS=7

# === 데이터베이스 ===
# 로컬: 미설정 시 SQLite 자동 사용 (data/pawpalja.db)
# Docker: docker-compose.yml에서 자동 설정
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pawpalja
CHROMA_PATH=./data/chroma

# === Docker 전용 ===
# docker compose up 시 PostgreSQL 비밀번호
DB_PASSWORD=change_this_db_password

# === 로깅 ===
LOG_LEVEL=INFO
LOG_FORMAT=json
